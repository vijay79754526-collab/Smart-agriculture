# Get a free API key from data.gov.in and keep it in Back end/.env.
DATA_GOV_IN_API_KEY=replace-with-your-data-gov-in-api-key

# Gmail SMTP settings for password reset codes.
# Enable 2-Step Verification and generate an App Password; never use your Gmail sign-in password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM=Smart Agriculture <your-gmail-address@gmail.com>

# Twilio SMS settings for registration confirmation messages.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567
